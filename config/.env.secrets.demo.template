# ── stambul-26 · secrets template ───────────────────────────────────────────
# Copy to config/.env.secrets (git-ignored, chmod 600) and fill in.
# Capture interactively: bash scripts/prj-tools/cf.sh auth
# Blank values only — non-empty literals here are a leak.

# Cloudflare API token: https://dash.cloudflare.com/profile/api-tokens
# Template «Edit Cloudflare Workers» (Workers Scripts:Edit + Account:Read)
CLOUDFLARE_API_TOKEN=

# Account ID: dash.cloudflare.com → Workers & Pages → right sidebar
CLOUDFLARE_ACCOUNT_ID=
