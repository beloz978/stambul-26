// Конфиг для Cloudflare Workers Builds.
// "name" должен СОВПАДАТЬ с именем вашего воркера в дашборде
// (заголовок страницы проекта). Если он другой — исправьте строку ниже.
{
  "name": "stambul-26",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash"
  }
}
