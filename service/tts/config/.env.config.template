# ── stambul-tts · non-secret config ─────────────────────────────────────────
# Rendered to config/.env.config by bash config/.env-render.sh (flat, no expansion).
# Secrets live in config/.env.secrets (git-ignored) — NEVER here.

# Цепочка провайдеров = порядок фолбэка. edge бесплатный, но требует `--extra edge`.
TTS_PROVIDERS=${TTS_PROVIDERS:-openai,edge}

TTS_DEFAULT_MODEL=${TTS_DEFAULT_MODEL:-gpt-4o-mini-tts}
TTS_DEFAULT_VOICE=${TTS_DEFAULT_VOICE:-alloy}
TTS_EDGE_DEFAULT_VOICE=${TTS_EDGE_DEFAULT_VOICE:-ru-RU-DmitryNeural}

TTS_OPENAI_BASE_URL=${TTS_OPENAI_BASE_URL:-https://api.openai.com/v1}
TTS_OPENAI_TIMEOUT_SEC=${TTS_OPENAI_TIMEOUT_SEC:-60}

# Кэш аудио: sha256(provider|model|voice|speed|format|text) → файл на диске.
TTS_CACHE_DIR=${TTS_CACHE_DIR:-./.cache/tts}
TTS_CACHE_ENABLED=${TTS_CACHE_ENABLED:-true}

# Список origin через запятую; * — открыто (годится, пока сервис за ключом).
TTS_CORS_ORIGINS=${TTS_CORS_ORIGINS:-*}

TTS_MAX_CHARS=${TTS_MAX_CHARS:-4000}

TTS_LOG_LEVEL=${TTS_LOG_LEVEL:-INFO}
TTS_LOG_JSON=${TTS_LOG_JSON:-true}
