# ── stambul-tts · secrets template ──────────────────────────────────────────
# Copy to config/.env.secrets (git-ignored, chmod 600) and fill in.
# Blank values only — non-empty literals here are a leak.

# Ключ OpenAI для /v1/audio/speech: https://platform.openai.com/api-keys
TTS_OPENAI_API_KEY=

# Ключи доступа К САМОМУ сервису, через запятую. Пусто → проверка выключена
# (годится только для localhost; для публичного адреса задайте обязательно).
# Клиент шлёт их как X-API-Key, Authorization: Bearer или ?key=<ключ>.
TTS_API_KEYS=
